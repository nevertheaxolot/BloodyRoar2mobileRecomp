<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#101010">

    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se ha seleccionado ningún disco del juego."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/text_bios_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No se ha seleccionado ningún BIOS."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/button_pick_iso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar ISO/BIN del juego" />

    <Button
        android:id="@+id/button_pick_bios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Seleccionar BIOS (SCPH1001.BIN)" />

    <CheckBox
        android:id="@+id/check_touch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:checked="true"
        android:text="Controles táctiles en pantalla"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Opacidad de los controles"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seek_touch"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:max="80"
        android:progress="20" />

    <Button
        android:id="@+id/button_launch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Iniciar juego"
        android:enabled="false" />

</LinearLayout>
